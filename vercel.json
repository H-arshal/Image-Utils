{
  "rewrites": [
    { "source": "/resize", "destination": "/index.html" },
    { "source": "/compress", "destination": "/index.html" },
    { "source": "/convert", "destination": "/index.html" },
    { "source": "/crop", "destination": "/index.html" },
    { "source": "/favicon", "destination": "/index.html" },
    { "source": "/circle", "destination": "/index.html" },
    { "source": "/radius", "destination": "/index.html" },
    { "source": "/border", "destination": "/index.html" },
    { "source": "/rotate", "destination": "/index.html" },
    { "source": "/watermark", "destination": "/index.html" },
    { "source": "/adjust", "destination": "/index.html" },
    { "source": "/pdf", "destination": "/index.html" },
    { "source": "/metadata", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
